{
  "cleanupPeriodDays": 7,
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {},
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(git fetch*)",
      "Bash(git ls-files*)",
      "Bash(git submodule*)",
      "Bash(git -C * status*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * log*)",
      "Bash(git -C * show*)",
      "Bash(git -C * branch*)",
      "Bash(git -C * rev-parse*)",
      "Bash(git -C * remote*)",
      "Bash(git -C * fetch*)",
      "Bash(git -C * ls-files*)",
      "Bash(git -C * submodule*)",
      "Bash(nvim --server *)",
      "Bash(kitty @*)",
      "Bash(chezmoi diff)",
      "Bash(chezmoi diff *)",
      "Bash(chezmoi managed)",
      "Bash(chezmoi managed *)",
      "Bash(chezmoi status)",
      "Bash(chezmoi status *)",
      "Bash(chezmoi cat *)",
      "Bash(chezmoi data)",
      "Bash(chezmoi data *)",
      "Bash(chezmoi source-path)",
      "Bash(chezmoi source-path *)",
      "Bash(chezmoi target-path *)",
      "Bash(chezmoi verify)",
      "Bash(chezmoi verify *)",
      "Bash(chezmoi doctor)",
      "Bash(chezmoi execute-template *)",
      "Bash(gh search *)",
      "Bash(gh api *)",
      "Bash(gh repo view *)",
      "Bash(gh repo list *)",
      "Bash(gh browse *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(GH_HOST=* gh search *)",
      "Bash(GH_HOST=* gh api *)",
      "Bash(GH_HOST=* gh repo view *)",
      "Bash(GH_HOST=* gh repo list *)",
      "Bash(GH_HOST=* gh browse *)",
      "Bash(GH_HOST=* gh run list *)",
      "Bash(GH_HOST=* gh run view *)",
      "Bash(GH_HOST=* gh pr list *)",
      "Bash(GH_HOST=* gh pr view *)",
      "Bash(GH_HOST=* gh issue list *)",
      "Bash(GH_HOST=* gh issue view *)",
      "Bash(GH_HOST=* gh release list *)",
      "Bash(GH_HOST=* gh release view *)",
      "Bash(helm --kube-context kind-* *)",
      "Bash(kubectl --context kind-* *)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "mcp__*",
      "Bash(gh *)",
      "Bash(glab *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(*| sudo *)",
      "Bash(su)",
      "Bash(su *)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(mkfs*)",
      "Bash(dd *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(chmod 777 *)",
      "Bash(chown *)",
      "Bash(chgrp *)",
      "Bash(gh repo delete*)",
      "Bash(gh auth login*)",
      "Bash(gh auth logout*)",
      "Bash(glab repo delete*)",
      "Bash(glab auth login*)",
      "Bash(glab auth logout*)",
      "Bash(*curl *|*sh*)",
      "Bash(*wget *|*sh*)",
      "Bash(*curl *|*bash*)",
      "Bash(*wget *|*bash*)",
      "Bash(*cat */.aws/*)",
      "Bash(*cat */.config/*)",
      "Bash(*cat */.azure/*)",
      "Bash(*cat */.kube/*)",
      "Bash(*cat */.ssh/*)",
      "Bash(*cat */.gnupg/*)",
      "Bash(*cat *.env*)",
      "Bash(*cat *secrets/*)",
      "Bash(*cat */.npmrc*)",
      "Bash(*cat */.pypirc*)",
      "Bash(*cat */.m2*)",
      "Bash(*cat */.gradle*)",
      "Bash(*cat */.git-credentials*)",
      "Bash(*cat */.netrc*)",
      "Bash(*cat */.bash_history*)",
      "Bash(*cat */.zsh_history*)",
      "Bash(*cat */.zsh_sessions/*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(telnet *)",
      "Bash(ftp *)",
      "Bash(sftp *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.m2/**)",
      "Read(~/.gradle/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Read(~/.zsh_sessions/**)",
      "Read(~/.docker/**)",
      "Read(~/.config/gh/**)",
      "Bash(*cat */.local/share/fish/fish_history*)",
      "Read(~/.local/share/fish/fish_history)"
    ]
  },
  "spinnerTipsEnabled": false,
  "teammateMode": "in-process"
}
