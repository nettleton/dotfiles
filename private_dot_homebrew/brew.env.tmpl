{{- /* HOMEBREW_NVD_API_KEY, not NVD_API_KEY: brew re-execs external commands
       (safe-upgrade, safe-install) through `env -i` keeping only HOMEBREW_*
       vars, so a plain NVD_API_KEY is dropped and NVD throttles to 5 req/30s
       (50 with a key). brew reads this file on every invocation, so this
       covers interactive runs, the install script, and the LaunchAgent. */ -}}
HOMEBREW_NVD_API_KEY={{ onepasswordRead "op://Private/NIST NVD API Key/credential" }}
{{/* HOMEBREW_GITHUB_API_TOKEN: the private nettleton/tap download strategy
       (e.g. calbuddy) hard-requires it and has no fallback. The op brew shell
       plugin injects it only for a top-level `brew` call, so `brew safe-upgrade`
       — which reaches the private download through the external brew-safe-upgrade
       command's own nested `brew` — never sees it and aborts. Setting it here
       covers every path: it's HOMEBREW_*-prefixed (survives brew's env -i into
       safe-upgrade and its child `brew upgrade`) and brew reads this file on
       every invocation, so interactive safe-upgrade, the install script, and the
       unattended LaunchAgent updater all get it. Resolved at apply time (same as
       the key above), so no runtime 1Password GUI prompt. Same install token the
       brew-install script uses. */ -}}
HOMEBREW_GITHUB_API_TOKEN={{ onepasswordRead "op://Family/nettleton-homebrew-install-token/token" }}
{{ if .is_child_machine -}}
HOMEBREW_CASK_OPTS=--fontdir=/Library/Fonts
{{ end -}}
